# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Pollinations AI ─────────────────────────────────────────────────────────
# Secret key (starts with sk_) from https://gen.pollinations.ai / https://enter.pollinations.ai
# NEVER exposed to the browser – it is only read by server-side API routes.
POLLINATIONS_API_KEY=sk_s6ajoTQiRkbMA8lDgWeBZxWSScDR0DoO

# ── Open mode (default ON) ──────────────────────────────────────────────────
# Unset/true → no login screens: every visitor is the local guest admin
#              account (ULTRA plan).
# false      → enable the full auth system (registration, email-verification
#              codes, sessions, password reset). Auth code is fully built.
AUTH_DISABLED=true
OPEN_USER_EMAIL=guest@veloris.local
OPEN_USER_NAME=Foulques

# ── Sessions ────────────────────────────────────────────────────────────────
# Any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-secret

# Session cookie policy. Default: in production = Secure + SameSite=None +
# Partitioned (works inside embedded/iframe previews). In dev = Lax, non-secure.
# Set COOKIE_SECURE=false only if you self-host production on plain http.
# COOKIE_SECURE=true

# ── Email delivery (Resend recommended) ─────────────────────────────────────
# Create an API key at https://resend.com/api-keys. Keep this server-side only.
RESEND_API_KEY=re_NMcK9M99_NMZTb8wzqYSghNu5V2gPjeQD
# Must be an email/domain verified in Resend, e.g. VELORIS <verification@yourdomain.com>
RESEND_FROM_EMAIL=

# Optional legacy SMTP fallback (used only if Resend is not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="VELORIS <no-reply@example.com>"

# ── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000

# Verified account that receives the initial ADMIN role (backend-enforced).
ADMIN_EMAIL=foulques.fns1@gmail.com
